# Copy this file to .env and fill in every value before use.
# .env is gitignored; never commit a filled-in copy.
#
# Docker Compose reads .env automatically from this directory. The automation
# scripts do NOT read it automatically: export the variables in your shell, or
# set them in the systemd units that run the scripts, or `set -a; . ./.env; set +a`.
#
# Placeholders such as <SERVER HOST> and CHANGE_ME must be replaced. Anything
# marked "secret" must never appear in Git, logs, screenshots, or backups you
# share.

# --- Panel (docker compose) --------------------------------------------------
# Web UI port. Bind this to the LAN/VPN only; never forward it.
MCSM_WEB_PORT=23333
# Daemon port. LAN/VPN only.
MCSM_DAEMON_PORT=24444
# Absolute host directory for MCSManager-managed instance data. Must match the
# bind source in compose.yaml and contain the server's <instance-data> dir.
MCSM_DOCKER_WORKSPACE_PATH=/srv/minecraft/instances
# Optional: container timezone, e.g. Etc/UTC or your region/city.
TZ=Etc/UTC

# --- Server identity ---------------------------------------------------------
# The docker container name of the Minecraft instance (as created in the panel).
CONTAINER=minecraft
# Absolute path to the instance data directory (the container's /data source).
# Required by backup.sh, daily-reset.sh, install-plugins.sh, season-end.sh.
SERVER_DIR=/srv/minecraft/instances/<instance-data>
# The container-side data mount point. Keep /data unless you changed it.
DATA_DEST=/data
# Directory name for installed plugins inside SERVER_DIR.
PLUGINS_DIR_NAME=plugins

# --- Backups -----------------------------------------------------------------
# Private, owner-only backup storage, outside Git and outside SERVER_DIR.
BACKUP_ROOT=/srv/minecraft/backups
# Lifecycle lock + reset state. Keep the dedicated .reset-state directory name.
STATE_DIR=/srv/minecraft/.reset-state
# Timezone for backup stamps, retention day/week boundaries, and schedules.
BACKUP_TIMEZONE=Etc/UTC
KEEP_DAILY=7
KEEP_WEEKLY=4
RCON_TIMEOUT=20
RCON_KILL_AFTER=2
# Space-separated plugin data directories archived with the world (relative to
# SERVER_DIR). Remove entries for plugins you do not run.
PLUGIN_DATA_DIRS=plugins/AwepeepsBlueMapCompass plugins/AwepeepsSpawnKit
# Exact parent paths that must never be used as SERVER_DIR or BACKUP_ROOT.
PROTECTED_PATHS=/ /home /root /srv /mnt /opt /usr /var /etc
# Internal: set to 1 only by a parent job that already holds the lifecycle lock.
BACKUP_LOCK_HELD=0

# --- Plugin manifest ---------------------------------------------------------
# Manifest used by install-plugins.sh (pipe-separated: name|source|version|url|sha256).
PLUGIN_MANIFEST=./plugins/plugins.list
# 1 = download and verify only, do not copy jars into plugins/.
DRY_RUN=0
# 1 = fail when any manifest entry is skipped (placeholder or non-jar source).
STRICT=0

# --- Guarded test-world reset ------------------------------------------------
# The last reset day is the day before this date; the job no-ops on and after it.
RESET_UNTIL=2030-01-01
# Seeds file (one literal integer per line). Blank lines and # comments ignored.
SEEDS_FILE=./automation/seeds.txt
READINESS_TIMEOUT=150
READINESS_INTERVAL=5
RCON_CALL_TIMEOUT=10
SHUTDOWN_TIMEOUT=150
BLUEMAP_PURGE_TIMEOUT=120
BLUEMAP_MAPS=world,world_the_nether,world_the_end
SPAWN_KIT_LOAD_X=0
SPAWN_KIT_LOAD_Z=0
SPAWN_KIT_LOAD_RADIUS=36
SPAWN_KIT_SETUP_TIMEOUT=90
# 1 = take a verified pre-wipe backup before wiping; never set 0 on real data.
PREWIPE_BACKUP=1
# Phase gate for backup-scheduled.sh: test before RESET_UNTIL, live on/after it.
BACKUP_PHASE=test
# Panel containers used to reopen the managed instance after a reset.
MCSM_WEB_CONTAINER=mcsm-web
MCSM_CONFIG=/opt/mcsmanager/web/data/RemoteServiceConfig
# Panel node id and instance id, from your MCSManager install. Not secrets, but
# instance-specific: keep them out of the public repo.
MCSM_NODE_ID=CHANGE_ME_NODE_ID
MCSM_INSTANCE_UUID=CHANGE_ME_INSTANCE_UUID

# --- Maintenance report and recovery -----------------------------------------
# systemd user units whose last result the report checks.
MAINTENANCE_UNITS=mc-backup-test mc-backup-live mc-daily-reset
# Seconds recovery-gate.sh waits for the lifecycle lock before giving up.
LOCK_TIMEOUT=1200

# --- Season records ----------------------------------------------------------
SERVER_SLUG=survival
SEASON_SLUG=season-1
# Repo root for season records; defaults to the repo checkout.
REPO_DIR=.

# --- Plugin source pins (used by automation/build-*.sh) ---------------------
# Prefer keeping these in config/sources/*.env (copied from the .env.example
# files there); the build helpers source that file by default. They are listed
# here so every variable a script reads is documented in one place.
CHESTCLEANER_SOURCE_REPOSITORY=https://github.com/Awepeeps/Awepeeps-ChestCleaner.git
CHESTCLEANER_SOURCE_COMMIT=TODO_40_HEX_SOURCE_COMMIT
CHESTCLEANER_VERSION=2.4.5-awepeeps.1
BLUEMAP_COMPASS_SOURCE_REPOSITORY=https://github.com/Awepeeps/Awepeeps-BlueMap-Compass.git
BLUEMAP_COMPASS_SOURCE_COMMIT=TODO_40_HEX_SOURCE_COMMIT
BLUEMAP_COMPASS_VERSION=1.4.1-awepeeps.8
SPAWN_KIT_SOURCE_REPOSITORY=https://github.com/Awepeeps/Awepeeps-SpawnKit.git
SPAWN_KIT_SOURCE_COMMIT=TODO_40_HEX_SOURCE_COMMIT
SPAWN_KIT_VERSION=1.1.3
# Override the env-file path each build helper sources:
CHESTCLEANER_SOURCE_ENV=./config/sources/chestcleaner.env
BLUEMAP_COMPASS_SOURCE_ENV=./config/sources/bluemap-compass.env
SPAWN_KIT_SOURCE_ENV=./config/sources/spawn-kit.env

# --- Awepeeps Whitelist Gate -------------------------------------------------
# SECRET: the Discord webhook URL the plugin uses to notify the owner. It is
# passed to the Minecraft container as an environment variable, never written to
# a config file. Leave the placeholder here; set the real value only in your
# private deployment or secret manager.
WLGATE_DISCORD_WEBHOOK_URL=CHANGE_ME_WEBHOOK_URL
