# FreedomChat settings to merge into the file generated by the selected release.
# Destination on the server: <instance-data>/plugins/FreedomChat/config.yml
# With rewrite-chat disabled, outgoing signed chat is not converted to system
# chat and is still reportable. This is not a chat-report protection setting.
# Keep claim-secure-chat-enforced false so the server does not advertise that
# secure chat is enforced; clients may continue to show the secure-chat warning.
# Check that the exact FreedomChat release supports these keys before applying.
rewrite-chat: false
claim-secure-chat-enforced: false
