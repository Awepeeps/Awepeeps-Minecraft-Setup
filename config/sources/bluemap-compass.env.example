# Copy this file to config/sources/bluemap-compass.env and fill it in.
# The real file is gitignored; this example is committed.
#
# Pin an exact reviewed commit; never follow a moving branch. The build helper
# clones this commit, runs the source repository's own build script, and verifies
# the resulting jar against the SHA-256 in plugins/plugins.list.
BLUEMAP_COMPASS_SOURCE_REPOSITORY=https://github.com/Awepeeps/Awepeeps-BlueMap-Compass.git
BLUEMAP_COMPASS_SOURCE_COMMIT=TODO_40_HEX_SOURCE_COMMIT
# Reference instance used 1.4.1-awepeeps.8. Update this to the version your pin builds.
BLUEMAP_COMPASS_VERSION=1.4.1-awepeeps.8
