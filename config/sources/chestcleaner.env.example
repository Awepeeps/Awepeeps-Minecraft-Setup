# Copy this file to config/sources/chestcleaner.env and fill it in.
# The real file is gitignored; this example is committed.
#
# Pin an exact reviewed commit reachable from the Awepeeps repository; never
# follow a moving branch. The build helper clones this commit, runs the source
# repository's own build script, and verifies the resulting jar against the
# SHA-256 in plugins/plugins.list.
CHESTCLEANER_SOURCE_REPOSITORY=https://github.com/Awepeeps/Awepeeps-ChestCleaner.git
CHESTCLEANER_SOURCE_COMMIT=TODO_40_HEX_SOURCE_COMMIT
# Reference instance used 2.4.5-awepeeps.1. Update this to the version your pin builds.
CHESTCLEANER_VERSION=2.4.5-awepeeps.1
