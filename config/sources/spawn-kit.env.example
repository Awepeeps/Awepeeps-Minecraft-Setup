# Copy this file to config/sources/spawn-kit.env and fill it in.
# The real file is gitignored; this example is committed.
#
# TEST-ONLY plugin. Pin an exact reviewed commit; never follow a moving branch.
# The build helper clones this commit and builds it in a digest-pinned
# Gradle/JDK container, then verifies the jar against plugins/test-plugins.list.
SPAWN_KIT_SOURCE_REPOSITORY=https://github.com/Awepeeps/Awepeeps-SpawnKit.git
SPAWN_KIT_SOURCE_COMMIT=TODO_40_HEX_SOURCE_COMMIT
# Version string your pin builds; keep it matching plugins/test-plugins.list.
# Spawn Kit 1.2.x and later load the chunks they need with plugin chunk tickets,
# so the reset does not force-load a spawn area on the plugin's behalf.
SPAWN_KIT_VERSION=1.3.3
